<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HoarderDB.Web</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Workstation, non-concurrent GC: measured ~100 MB lower peak than server GC at the same import time; managed heap is minor here. Web only (Cli/Core unchanged). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HoarderDB.Core\HoarderDB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HoarderDB.Web.Tests" />
  </ItemGroup>

</Project>
